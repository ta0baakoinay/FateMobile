<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FateMobile"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">
        <!--
          usesCleartextTraffic is required because the rAthena login/char/map
          protocol is plain TCP with no TLS (see docs/FATE_MMO_MOBILE_PROTOCOL.md §7).
          This is a raw socket, not HTTP, so it is unaffected by Android's
          Network Security Config cleartext-HTTP restrictions either way, but the
          flag is set explicitly and documented rather than silently relied upon.
        -->

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.FateMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
